<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/short_code_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pairing_short_code_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:id="@+id/short_code_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:text="@string/pairing_short_code_display_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/muted" />

    <com.wootodo.ui.SixDigitCodeView
        android:id="@+id/short_code_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp" />

    <TextView
        android:id="@+id/short_code_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:text="@string/pairing_short_code_creating"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/muted" />

    <TextView
        android:id="@+id/short_code_expiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:text="@string/pairing_short_code_expiry"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/muted" />

    <LinearLayout
        android:id="@+id/short_code_verification_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/pairing_short_code_verification_label"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/muted" />

        <com.wootodo.ui.SixDigitCodeView
            android:id="@+id/short_code_verification"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:text="@string/pairing_short_code_verification_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/muted" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/short_code_confirm"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/pairing_short_code_confirm"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/short_code_cancel"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/pairing_short_code_cancel" />

</LinearLayout>
