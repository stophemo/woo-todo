<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/category_drag_handle"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/category_drag_handle"
        android:padding="10dp"
        android:src="@drawable/ic_drag_handle"
        app:tint="@color/muted" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/category_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/task_text" />

        <TextView
            android:id="@+id/category_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_fallback"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/muted"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/category_more"
        android:layout_width="44dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/muted" />

</LinearLayout>
