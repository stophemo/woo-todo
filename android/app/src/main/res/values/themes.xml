<resources>
    <style name="Theme.WooTodo" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSurface">@color/paper_bright</item>
        <item name="colorOnSurface">@color/task_text</item>
        <item name="colorOutline">@color/line</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="WooTodo.ScopeButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/scope_button_background</item>
        <item name="android:textColor">@color/scope_button_text</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">38dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
</resources>
