<Window x:Class="WooTodo.WindowsApp.FloatingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="今日任务" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False" Background="#F2FFFFFF" MinWidth="320" MinHeight="360">
  <Border BorderBrush="#28000000" BorderThickness="1" CornerRadius="8" Padding="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid MouseLeftButtonDown="HeaderMouseDown">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="今日任务" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
          <TextBlock x:Name="DateText" Margin="0,3,0,0" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource IconButton}" Content="&#xE710;" ToolTip="新增任务" Click="AddClicked" />
          <Button Style="{StaticResource IconButton}" Content="&#xE713;" Margin="6,0,0,0" ToolTip="打开任务详情与统计" Click="OpenMainClicked" />
        </StackPanel>
      </Grid>
      <Border Grid.Row="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Margin="0,14,0,10" />
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="TaskPanel" />
      </ScrollViewer>
      <Grid Grid.Row="3" Margin="0,12,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBox x:Name="QuickAddTextBox" ToolTip="输入今日主线任务" KeyDown="QuickAddKeyDown" />
        <Button Grid.Column="1" Content="添加" Margin="8,0,0,0" Background="{StaticResource AccentBrush}" Foreground="White" Click="QuickAddClicked" />
      </Grid>
    </Grid>
  </Border>
</Window>
