<Window x:Class="WooTodo.WindowsApp.TaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="任务" Width="450" Height="470" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="任务内容" Foreground="{StaticResource SecondaryTextBrush}" />
    <TextBox x:Name="TitleTextBox" Grid.Row="1" Margin="0,7,0,16" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="16" /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="时间范围" Foreground="{StaticResource SecondaryTextBrush}" />
        <ComboBox x:Name="TimeTypeCombo" Margin="0,7,0,16" SelectionChanged="TimeTypeChanged" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="任务级别" Foreground="{StaticResource SecondaryTextBrush}" />
        <ComboBox x:Name="QuestLineCombo" Margin="0,7,0,16" />
      </StackPanel>
    </Grid>
    <TextBlock Grid.Row="3" Text="目标日期" Foreground="{StaticResource SecondaryTextBrush}" />
    <DatePicker x:Name="TargetDatePicker" Grid.Row="4" Margin="0,7,0,16" Height="36" />
    <StackPanel Grid.Row="5" Orientation="Horizontal">
      <CheckBox x:Name="RepeatsCheckBox" Content="每个所属周期重复" VerticalAlignment="Center" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Grid.Row="6" Margin="0,14,0,0" Foreground="#B42318" TextWrapping="Wrap" />
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Margin="0,0,8,0" IsCancel="True" />
      <Button Content="保存" Background="{StaticResource AccentBrush}" Foreground="White" Click="SaveClicked" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
